{
  "manifest_version": 3,
  "name": "Stream Recorder Pro",
  "version": "4.0.0",
  "description": "Reverse engineer streaming sites - capture APIs, streams, and generate Python extractors for Enigma2",
  "permissions": [
    "storage",
    "downloads",
    "webRequest",
    "tabs",
    "activeTab",
    "scripting",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "websocket-hook.js",
        "page-hook.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stream Recorder Pro"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "take-snapshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Take Snapshot"
    },
    "toggle-recording": {
      "suggested_key": {
        "default": "Ctrl+Shift+R"
      },
      "description": "Toggle Recording"
    },
    "open-popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      },
      "description": "Open Popup"
    }
  }
}